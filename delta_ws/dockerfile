# syntax=docker/dockerfile:1
# ROS 2 on Raspberry Pi 5 (linux/arm64) with C++ (ament_cmake) and Python (ament_python) packages.
# Expected layout next to this file:
#   src/my_cpp_pkg/     (ament_cmake)
#   src/my_py_pkg/      (ament_python)

ARG ROS_DISTRO=jazzy

############################
# Stage 1: build
############################
FROM ros:${ROS_DISTRO}-ros-base AS builder
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git \
        python3-pip python3-colcon-common-extensions python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY src/ src/

# Resolve every dependency declared in package.xml files (C++ and Python alike)
RUN apt-get update \
    && (rosdep init 2>/dev/null || true) && rosdep update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/*

# Pi 5 has 4 cores; limit parallelism if you build on-device with little RAM
RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --parallel-workers 4

############################
# Stage: dev (interactive development)
# Source is NOT baked in: it is bind-mounted at /ws/src by docker compose,
# and you run colcon build inside the container.
# Rebuild this image only when package dependencies change.
############################
FROM ros:${ROS_DISTRO}-ros-base AS dev
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=${ROS_DISTRO}

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git gdb ccache \
        python3-pip python3-colcon-common-extensions python3-rosdep \
        i2c-tools python3-smbus2 vim nano bash-completion \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies declared in package.xml files, then discard the source
COPY src/ /tmp/src/
RUN apt-get update \
    && (rosdep init 2>/dev/null || true) && rosdep update \
    && rosdep install --from-paths /tmp/src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/* /tmp/src

# Make every shell (including `docker compose exec`) ROS-ready
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo '[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash' >> /root/.bashrc

WORKDIR /ws
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]

############################
# Stage 2: runtime
############################
FROM ros:${ROS_DISTRO}-ros-base AS runtime
ARG ROS_DISTRO
ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=${ROS_DISTRO} \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp

WORKDIR /ws

# System tools and Python libraries needed at runtime
# i2c-tools: i2cdetect for debugging inside the container
# python3-smbus2: the I2C library used by the Python node
RUN apt-get update && apt-get install -y --no-install-recommends \
        i2c-tools python3-smbus2 \
    && rm -rf /var/lib/apt/lists/*

# Install only runtime (exec) dependencies declared in package.xml
COPY src/ /tmp/src/
RUN apt-get update \
    && (rosdep init 2>/dev/null || true) && rosdep update \
    && rosdep install --from-paths /tmp/src --ignore-src -r -y \
         --dependency-types=exec \
    && rm -rf /var/lib/apt/lists/* /tmp/src

COPY --from=builder /ws/install /ws/install
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]